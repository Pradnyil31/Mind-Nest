rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserOwnedPath() {
      return isSignedIn() && (
        (request.resource != null && request.resource.name.matches('users/' + request.auth.uid + '/.*')) ||
        (resource != null && resource.name.matches('users/' + request.auth.uid + '/.*'))
      );
    }

    match /{allPaths=**} {
      allow read, write: if isUserOwnedPath();
    }
  }
}
